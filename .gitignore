# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-server.log
*.log
messages-i18n-snapshot.txt
messages-test-output.txt
vi-current.txt
vitest-current.txt
vt-a.txt
vt-filter.cjs

# env files (never commit real credentials)
.env*
!.env.example

# vercel
.vercel

# supabase cli local state (project link info, cached versions)
/supabase/.temp

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Netlify folder
.netlify
